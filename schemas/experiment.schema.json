{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Dossiya-SE/Differential-geometry-and-Mathematics-arts-for-sustainability-and-resilience/schemas/experiment.schema.json",
  "title": "MSR experiment record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "experiment_id",
    "version",
    "title",
    "status",
    "model_id",
    "application_decision",
    "research_question",
    "acceptance_rule",
    "execution",
    "inputs",
    "parameters",
    "outputs",
    "verification",
    "limitations"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0.0"},
    "experiment_id": {"type": "string", "pattern": "^MSR-EXP-[0-9]{4}$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "record_date": {"type": "string", "format": "date"},
    "title": {"type": "string", "minLength": 8},
    "status": {
      "type": "string",
      "enum": ["PREREGISTERED", "REFERENCE_VERIFIED", "EXPLORATORY", "FAILED", "SUPERSEDED"]
    },
    "model_id": {"type": "string", "pattern": "^MSR-MOD-[0-9]{4}$"},
    "model_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "application_decision": {"type": "string", "enum": ["NOT_SELECTED", "SELECTED"]},
    "research_question": {"type": "string", "minLength": 20},
    "acceptance_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metric", "operator", "threshold"],
      "properties": {
        "metric": {"type": "string", "minLength": 1},
        "operator": {"type": "string", "enum": ["<=", "<", ">=", ">", "=="]},
        "threshold": {"type": "number"}
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entry_point", "deterministic", "random_seed", "precision", "environment"],
      "properties": {
        "entry_point": {"type": "string", "minLength": 1},
        "deterministic": {"type": "boolean"},
        "random_seed": {"type": ["integer", "null"]},
        "precision": {"type": "string", "minLength": 1},
        "environment": {"type": "string", "minLength": 1}
      }
    },
    "inputs": {"type": "array", "items": {"type": "object"}, "minItems": 1},
    "parameters": {"type": "object"},
    "outputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "path", "media_type"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1},
          "media_type": {"type": "string", "minLength": 1},
          "sha256": {"type": ["string", "null"]}
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tests", "result_status", "independent_review"],
      "properties": {
        "tests": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "result_status": {"type": "string", "enum": ["PASS", "FAIL", "NOT_RUN"]},
        "independent_review": {"type": "string", "enum": ["COMPLETED", "NOT_COMPLETED"]}
      }
    },
    "limitations": {"type": "array", "items": {"type": "string"}, "minItems": 1}
  }
}
