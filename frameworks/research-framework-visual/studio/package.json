    "react": "19.1.1",
    "react-dom": "19.1.1",
    "three": "0.179.1",
    "vega-lite": "6.4.3"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.4",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "@types/three": "0.179.0",
    "@vitejs/plugin-react": "5.0.2",
