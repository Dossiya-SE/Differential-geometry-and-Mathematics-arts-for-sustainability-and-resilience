{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mvs.local/schema/engine-pack-v1.schema.json",
  "title": "MVS Engine Pack Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "version", "platform", "adapterProtocol", "entrypoint", "runtime", "capabilities", "payloadSha256", "lockSha256"],
  "properties": {
    "schema": { "const": "mvs.engine-pack/1" },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+" },
    "platform": { "type": "string", "minLength": 3 },
    "adapterProtocol": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
    "entrypoint": { "type": "string", "minLength": 1 },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "version"],
      "properties": {
        "kind": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["filesystem", "network", "processSpawn"],
      "properties": {
        "filesystem": {
          "type": "object",
          "additionalProperties": false,
          "required": ["read", "write"],
          "properties": {
            "read": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
            "write": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
          }
        },
        "network": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "processSpawn": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
      }
    },
    "payloadSha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "lockSha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  }
}
